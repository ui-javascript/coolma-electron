{
  "name": "libs-rune-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rune 卡片纯逻辑：快捷面板 item、SFC props 解析（零框架依赖）",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "lib",
    "src"
  ],
  "main": "lib/index.cjs",
  "module": "lib/index.esm.js",
  "types": "src/index.ts",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --outfile=lib/index.esm.js --format=esm && esbuild src/index.ts --bundle --outfile=lib/index.cjs --format=cjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
