{
  "name": "desktop-vue3",
  "version": "0.1.0",
  "private": true,
  "description": "Coolma Vue3 desktop app rebuilt on electron-egg TypeScript",
  "main": "./public/electron/main.js",
  "author": "luo0412",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=12.18.0"
  },
  "scripts": {
    "dev": "ee-bin dev",
    "dev-frontend": "ee-bin dev --serve=frontend",
    "dev-electron": "ee-bin dev --serve=electron",
    "build": "pnpm run build-frontend && pnpm run build-electron",
    "build-frontend": "ee-bin build --cmds=frontend && ee-bin move --flag=frontend_dist",
    "build-electron": "ee-bin build --cmds=electron",
    "build-w": "ee-bin build --cmds=win64",
    "build-we": "ee-bin build --cmds=win_e",
    "build-m": "ee-bin build --cmds=mac",
    "build-m-arm64": "ee-bin build --cmds=mac_arm64",
    "build-l": "ee-bin build --cmds=linux",
    "start": "ee-bin start",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --dir frontend run typecheck",
    "rebuild:sqlite": "node scripts/fetch-better-sqlite3-prebuild.mjs",
    "icon": "ee-bin icon",
    "test:db": "node -e \"require('esbuild').buildSync({entryPoints:['scripts/db-test.ts'],bundle:true,format:'cjs',platform:'node',outfile:'/tmp/coolma-db-test.js',logLevel:'error'})\" && node /tmp/coolma-db-test.js",
    "sync:builtins": "node scripts/sync-builtins-from-vue2.mjs && node scripts/gen-builtins.mjs",
    "gen:builtins": "node scripts/gen-builtins.mjs",
    "test:runtime": "vite build --config scripts/vite-runtime.config.mts && NODE_PATH=./node_modules node scripts/.rt-dist/rt.mjs"
  },
  "dependencies": {
    "@altairwei/wiz-markdown": "^1.0.13",
    "@vue/compiler-sfc": "2.7.16",
    "better-sqlite3": "^12.11.1",
    "ee-core": "4.1.5",
    "electron-updater": "^6.8.11",
    "enum-plus": "^3.4.0",
    "ssh2": "^1.17.0",
    "turndown": "^7.2.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-vue": "^5.2.4",
    "ee-bin": "4.2.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.3.5",
    "esbuild": "0.28.2",
    "jquery": "^3.7.1",
    "jsdom": "^24.1.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
