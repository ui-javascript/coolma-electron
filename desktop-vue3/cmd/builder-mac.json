{
  "productName": "Coolma Vue3",
  "appId": "cn.coolma.vue3",
  "copyright": "Copyright © 2026 Coolma Vue3 contributors",
  "directories": {
    "output": "out"
  },
  "asar": true,
  "npmRebuild": false,
  "files": [
    "public/**/*",
    "package.json",
    "!public/**/*.map"
  ],
  "mac": {
    "icon": "build/icons/icon.icns",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "darkModeSupport": true,
    "hardenedRuntime": false,
    "target": ["dmg", "zip"]
  }
}
