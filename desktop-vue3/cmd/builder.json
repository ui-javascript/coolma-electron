{
  "productName": "Coolma Vue3",
  "appId": "cn.coolma.vue3",
  "copyright": "Copyright © 2026 Coolma Vue3 contributors",
  "directories": {
    "output": "out"
  },
  "asar": true,
  "npmRebuild": false,
  "extraResources": [
    {
      "from": "../_plugins/plugin-hel-doubao-input-vue3/dist",
      "to": "doubao-input"
    }
  ],
  "files": [
    "public/**/*",
    "package.json",
    "!public/**/*.map"
  ],
  "nsis": {
    "oneClick": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "installerIcon": "build/icons/icon.ico",
    "uninstallerIcon": "build/icons/icon.ico",
    "installerHeaderIcon": "build/icons/icon.ico",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Coolma Vue3"
  },
  "win": {
    "icon": "build/icons/icon.ico",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "publish": [
    {
      "provider": "github",
      "owner": "ui-javascript",
      "repo": "coolma-electron",
      "releaseType": "draft"
    }
  ]
}