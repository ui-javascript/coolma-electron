{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["../electron/shared/*"],
      "echo-core": ["../../echo-core/src/index.ts"],
      "rune-core": ["../../rune-core/src/index.ts"]
    },
    "types": ["vite/client"]
  },
  "include": [
    "../packages/libs-muya-v3/src/**/*.ts",
    "../packages/plugins-muya-echo/src/**/*.ts",
    "../packages/plugins-muya-rune/src/**/*.ts",
    "../../echo-core/src/**/*.ts",
    "../../rune-core/src/**/*.ts",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "../electron/shared/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
