{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coolma Tauri",
  "version": "2026.11.4",
  "identifier": "cn.coolma.tauri",
  "build": {
    "beforeDevCommand": "pnpm run dev:frontend",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm run build:frontend",
    "frontendDist": "../dist/spa"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Coolma Tauri", "width": 1280, "height": 800, "minWidth": 820, "minHeight": 560, "decorations": false }
    ],
    "security": { "capabilities": ["main"] }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "resources": {
      "sidecar/**/*": "sidecar/"
    }
  }
}
