{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coolma Tauri",
  "version": "2026.11.4",
  "identifier": "cn.coolma.tauri",
  "build": {
    "beforeDevCommand": "pnpm run dev:frontend",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm run build:frontend",
    "frontendDist": "../dist/spa"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Coolma Tauri", "width": 900, "height": 600, "minWidth": 600, "minHeight": 400, "decorations": false, "dragDropEnabled": false }
    ],
    "security": { "capabilities": ["main"] }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBNDJGRkQ1QUQzMkUxMUYKUldRZjRUS3QxZjlDMm9RdEI0a3ovMlEyeWtGdDkwZzVoYUErSFVtdWNNT2hXU29VUGZpOTMvOXoK",
      "endpoints": [
        "https://github.com/ui-javascript/coolma-electron/releases/download/tauri-latest/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "resources": {
      "sidecar": "sidecar"
    }
  }
}
