{
  "name": "echo-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Echo 卡片纯逻辑：快捷面板 item、占位文本、插入处理器（零框架依赖）",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "lib",
    "src"
  ],
  "main": "lib/index.cjs",
  "module": "lib/index.esm.js",
  "types": "src/index.ts",
  "scripts": {
    "build": "esbuild src/index.ts --outfile=lib/index.esm.js --format=esm && esbuild src/index.ts --outfile=lib/index.cjs --format=cjs"
  }
}
